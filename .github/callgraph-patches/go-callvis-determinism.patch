@@ -8,6 +8,7 @@ import (
 	"os"
 	"os/exec"
 	"path/filepath"
+	"sort"
 	"strings"
 	"text/template"
 )
@@ -71,6 +72,21 @@ type dotCluster struct {
 	Attrs    dotAttrs
 }
 
+// sortClusterNodes sorts c's own Nodes slice, and recurses into every
+// nested sub-cluster (grouping by package/type populates c.Clusters, one
+// level per group). c.Clusters itself is a map, but text/template's range
+// already visits map keys in sorted order, so only each level's Nodes
+// slice -- populated in non-deterministic callgraph traversal order --
+// needs sorting here.
+func sortClusterNodes(c *dotCluster) {
+	sort.Slice(c.Nodes, func(i, j int) bool {
+		return c.Nodes[i].ID < c.Nodes[j].ID
+	})
+	for _, sub := range c.Clusters {
+		sortClusterNodes(sub)
+	}
+}
+
 func NewDotCluster(id string) *dotCluster {
 	return &dotCluster{
 		ID:       id,
@@ -108,6 +124,9 @@ func (p dotAttrs) List() []string {
 	for k, v := range p {
 		l = append(l, fmt.Sprintf("%s=%q", k, v))
 	}
+	// p is a map, so its iteration order is randomized; sort so the
+	// rendered attribute list is stable for a fixed set of attributes.
+	sort.Strings(l)
 	return l
 }
 
