# Local-only development file, never committed (see local dev notes).
CLAUDE.md
CLAUDE.md_BAK

# Fine-grained GitHub PAT, local-only, never committed.
github-token.txt

# Local tool state: personal permission overrides (the ".local" suffix
# marks this as machine-specific, never meant for version control) and
# worktree checkouts created for background/parallel sessions — never
# committed, same local-only-tooling-artifact principle as the two
# files ignored above.
.claude/settings.local.json
.claude/worktrees/

# Go build artifacts
/bin/
*.test
*.out

# GoReleaser build output, and the release pipeline's own before.hooks
# output (see .goreleaser.yaml — the generated /etc/breakthrough/config
# the .deb/.rpm packages ship, regenerated fresh on every release)
dist/
.goreleaser-generated/

# go-callvis writes this raw Graphviz source next to the checked-in
# callgraph.svg. Only the rendered SVG is a canonical, committed artifact;
# the intermediate .gv file is regenerated every time and never meant to
# be tracked.
docs/images/callgraph.gv
